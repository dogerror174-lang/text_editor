#include <iostream>
#include <fstream>
#include <string>
#include <vector>
#include <algorithm>
#include <cstdlib>
#include <ctime>

class TextEditor {
private:
    std::string content;
    bool distorted;
    
    // Функция искажения текста
    std::string distortText(const std::string& text) {
        if (text.empty()) return text;
        
        std::string result = text;
        int distortPercent = 30; // Процент искаженных символов
        
        // Искажаем случайные символы
        for (size_t i = 0; i < result.length(); i++) {
            if (rand() % 100 < distortPercent) {
                // Заменяем символ на случайный
                if (isalpha(result[i])) {
                    if (isupper(result[i])) {
                        result[i] = 'A' + rand() % 26;
                    } else {
                        result[i] = 'a' + rand() % 26;
                    }
                } else if (isdigit(result[i])) {
                    result[i] = '0' + rand() % 10;
                }
            }
        }
        
        // Добавляем случайные пробелы или удаляем их
        for (size_t i = 0; i < result.length(); i += rand() % 5 + 1) {
            if (rand() % 100 < 10) {
                if (rand() % 2 == 0 && i < result.length() - 1) {
                    result.insert(i, 1, ' ');
                } else if (result.length() > 1) {
                    result.erase(i, 1);
                }
            }
        }
        
        return result;
    }
    
    // Обработка триггеров в тексте
    void processTriggers() {
        size_t pos = 0;
        std::string trigger = "!distort";
        
        while ((pos = content.find(trigger, pos)) != std::string::npos) {
            // Находим границы искажаемого текста (до следующей команды или конца)
            size_t start = pos + trigger.length();
            
            // Пропускаем пробелы после триггера
            while (start < content.length() && isspace(content[start])) {
                start++;
            }
            
            // Ищем конец абзаца или следующую команду
            size_t end = content.find("!end", start);
            if (end == std::string::npos) {
                end = content.find("\n\n", start);
                if (end == std::string::npos) end = content.length();
            }
            
            // Искажаем текст между триггером и концом
            if (start < end) {
                std::string toDistort = content.substr(start, end - start);
                std::string distorted = distortText(toDistort);
                content.replace(start, end - start, distorted);
                pos = start + distorted.length();
                distorted = true;
            } else {
                pos += trigger.length();
            }
        }
    }
    
public:
    TextEditor() : distorted(false) {
        srand(static_cast<unsigned int>(time(0)));
    }
    
    // Загрузка файла
    bool loadFile(const std::string& filename) {
        std::ifstream file(filename);
        if (!file.is_open()) {
            std::cout << "Не удалось открыть файл: " << filename << std::endl;
            return false;
        }
        
        content.assign((std::istreambuf_iterator<char>(file)),
                       std::istreambuf_iterator<char>());
        file.close();
        
        // Обрабатываем триггеры при загрузке
        processTriggers();
        return true;
    }
    
    // Сохранение файла
    bool saveFile(const std::string& filename) {
        std::ofstream file(filename);
        if (!file.is_open()) {
            std::cout << "Не удалось создать файл: " << filename << std::endl;
            return false;
        }
        
        file << content;
        file.close();
        
        std::cout << "Файл сохранен: " << filename;
        if (distorted) {
            std::cout << " (с искаженными разделами)";
        }
        std::cout << std::endl;
        return true;
    }
    
    // Редактирование текста
    void editText() {
        std::cout << "Текстовый редактор. Команды:" << std::endl;
        std::cout << "  !distort - пометить текст для искажения" << std::endl;
        std::cout << "  !end - завершить искажаемый блок" << std::endl;
        std::cout << "  !save - сохранить и выйти" << std::endl;
        std::cout << "  !exit - выйти без сохранения" << std::endl;
        std::cout << "  !view - просмотреть текущий текст" << std::endl;
        std::cout << std::endl;
        
        std::string input;
        while (true) {
            std::cout << ">> ";
            std::getline(std::cin, input);
            
            if (input == "!exit") {
                std::cout << "Выход без сохранения." << std::endl;
                break;
            } else if (input == "!save") {
                std::cout << "Введите имя файла для сохранения: ";
                std::string filename;
                std::getline(std::cin, filename);
                saveFile(filename);
                break;
            } else if (input == "!view") {
                std::cout << "\n--- Текущий текст ---\n";
                std::cout << content << std::endl;
                std::cout << "--- Конец текста ---\n";
            } else {
                // Добавляем текст с обработкой команд
                if (input.find("!distort") == 0) {
                    content += "\n" + input;
                } else {
                    content += "\n" + input;
                }
                
                // Обрабатываем триггеры после добавления
                processTriggers();
            }
        }
    }
    
    // Просмотр текста с подсветкой искаженных областей
    void displayText() const {
        std::cout << "\n=== СОДЕРЖИМОЕ ФАЙЛА ===\n";
        
        size_t pos = 0;
        std::string trigger = "!distort";
        
        while (pos < content.length()) {
            size_t nextTrigger = content.find(trigger, pos);
            
            // Выводим нормальный текст
            if (nextTrigger != pos) {
                size_t len = (nextTrigger == std::string::npos) ? 
                             content.length() - pos : nextTrigger - pos;
                std::cout << content.substr(pos, len);
                pos += len;
            }
            
            // Выводим искаженный текст с пометкой
            if (nextTrigger != std::string::npos) {
                std::cout << "\n[ИСКАЖЕННЫЙ ТЕКСТ]: ";
                pos = nextTrigger + trigger.length();
                
                // Пропускаем пробелы
                while (pos < content.length() && isspace(content[pos])) {
                    pos++;
                }
                
                // Ищем конец искаженного блока
                size_t end = content.find("!end", pos);
                if (end == std::string::npos) {
                    end = content.find("\n\n", pos);
                    if (end == std::string::npos) end = content.length();
                }
                
                if (pos < end) {
                    std::cout << content.substr(pos, end - pos);
                    pos = end;
                }
                std::cout << " [КОНЕЦ ИСКАЖЕННОГО ТЕКСТА]\n";
            }
        }
        
        std::cout << "\n=== КОНЕЦ ФАЙЛА ===\n";
    }
};

// Пример использования
int main() {
    std::cout << "Текстовый редактор с триггерами искажения\n";
    
    TextEditor editor;
    
    // Выбор режима работы
    std::cout << "Выберите режим:\n";
    std::cout << "1. Загрузить существующий файл\n";
    std::cout << "2. Создать новый файл\n";
    std::cout << "Ваш выбор: ";
    
    std::string choice;
    std::getline(std::cin, choice);
    
    if (choice == "1") {
        std::cout << "Введите имя файла: ";
        std::string filename;
        std::getline(std::cin, filename);
        
        if (!editor.loadFile(filename)) {
            std::cout << "Создаем новый файл.\n";
        }
    }
    
    // Просмотр текущего содержимого
    editor.displayText();
    
    // Редактирование
    editor.editText();
    
    return 0;
}
